rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Anyone can read results (public live_status.html page).
    // Only a signed-in admin (see admin.html) can write/update them.
    match /results/{eventId} {
      allow read: if true;
      allow write: if request.auth != null;
    }

    // Anyone can read announcements (public index.html / announcements.html).
    // Only a signed-in admin can post/delete them.
    match /announcements/{announcementId} {
      allow read: if true;
      allow write: if request.auth != null;
    }
  }
}
